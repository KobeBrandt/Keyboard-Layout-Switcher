<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Needed by the code that [LibraryImport] generates. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>KeyboardLayoutSwitcher</AssemblyName>
    <RootNamespace>KeyboardLayoutSwitcher</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.1.0</Version>
    <Product>Keyboard Layout Switcher</Product>
    <Description>Switches the Windows keyboard layout based on which keyboards are connected.</Description>
    <Authors>Kobe Brandt</Authors>
    <Copyright>Copyright (c) 2026 Kobe Brandt</Copyright>
    <RepositoryUrl>https://github.com/KobeBrandt/Keyboard-Layout-Switcher</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives below this folder; keep its files out of the app. -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <InternalsVisibleTo Include="KeyboardLayoutSwitcher.Tests" />
  </ItemGroup>

</Project>
